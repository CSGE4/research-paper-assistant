# 复制成 .env 再填值：cp .env.example .env
# .env 已经在 .gitignore 里，不会被提交
#
# 注意：变量名区分大小写，Linux/macOS 上大小写写错会读不到

# ==================== 必填 ====================
# 阿里云百炼（DashScope）API Key，控制台 → API-KEY 管理
# 一个 key 同时用于三处：qwen3.8-max 对话、text-embedding-v4 向量化、
# paper_extractor 结构化抽取的兜底模型
DASHSCOPE_API_KEY=sk-你的key

# DashScope 的 OpenAI 兼容接口地址（一般不用改）
qwen_url=https://dashscope.aliyuncs.com/compatible-mode/v1


# ==================== 联网搜索（可选）====================
# 只有用到 search_tools（Tavily 联网）时才需要
# 变量名必须全大写 TAVILY_API_KEY：langchain-tavily 只认这个名字
# 写成小写 tavily_api_key 在 Windows 上能跑（环境变量不区分大小写），
# 换到 Linux 就报缺 key
TAVILY_API_KEY=tvly-你的key


# ==================== 结构化抽取（可选）====================
# 0 = 只用规则抽取，不调大模型；1 = 规则抽不到时调大模型兜底
MODEL_EXTRACT_ENABLED=1

# 兜底模型的尝试顺序，逗号分隔；留空用默认
MODEL_EXTRACT_MODELS=


# ==================== 换用 DeepSeek（可选）====================
# 不填就用上面的 DASHSCOPE_API_KEY + qwen_url
deepseek_api_key=
deepseek_url=https://api.deepseek.com/v1


# ==================== 不建议填 ====================
# LANGSMITH_* 三个变量：只在调试链路追踪时需要。
# 填了会在每次调用时往 api.smith.langchain.com 上传 trace，
# 国内网络下会报 403 Forbidden 干扰日志，比赛演示时建议留空。
